{
  "name": "todo-mcp",
  "version": "0.1.0",
  "description": "MCP-compatible todo backend with SSE and streaming entrypoints",
  "main": "dist/index.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "sse": "tsx src/index.sse.ts",
    "streaming": "tsx src/index.streaming.ts",
    "debug-sse": "LOG_LEVEL=debug DEBUG_TOOL_CALLS=true NODE_ENV=development tsx src/index.sse.ts",
    "test": "LOG_LEVEL=error vitest run --passWithNoTests",
    "test:watch": "LOG_LEVEL=error vitest --passWithNoTests",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit && tsc -p packages/todo-ui/tsconfig.json --noEmit",
    "dev:ui": "vite --config packages/todo-ui/vite.config.ts",
    "build:ui": "vite build --config packages/todo-ui/vite.config.ts",
    "preview:ui": "vite preview --config packages/todo-ui/vite.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vitest": "^4.0.8"
  }
}
