{
  "name": "todo-mcp",
  "version": "0.1.0",
  "description": "MCP-compatible todo backend with SSE and streaming entrypoints",
  "main": "dist/index.js",
  "type": "commonjs",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "sse": "tsx src/index.sse.ts",
    "streaming": "tsx src/index.streaming.ts",
    "debug-sse": "LOG_LEVEL=debug DEBUG_TOOL_CALLS=true NODE_ENV=development tsx src/index.sse.ts",
    "test": "LOG_LEVEL=error vitest run --passWithNoTests",
    "test:watch": "LOG_LEVEL=error vitest --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
